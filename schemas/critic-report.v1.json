{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vibe-ui.io/schemas/critic-report.v1.json",
  "title": "CriticReport",
  "description": "Style-aware Design Critic evaluation report schema in Vibe UI V3.",
  "type": "object",
  "required": [
    "hard_gates_pass",
    "quality_score",
    "acceptance_status",
    "scorecard",
    "defects_ranked"
  ],
  "properties": {
    "timestamp": { "type": "string" },
    "iteration": { "type": "integer", "minimum": 1, "maximum": 3 },
    "evaluated_style": { "type": "string" },
    "hard_gates_pass": { "type": "boolean" },
    "hard_gate_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "message"],
        "properties": {
          "gate": { "type": "string" },
          "message": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "quality_score": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
    "scorecard": {
      "type": "object",
      "required": [
        "visual_hierarchy",
        "anti_slop_distinctiveness",
        "domain_fit",
        "usability",
        "typography",
        "responsive",
        "state_completeness"
      ],
      "properties": {
        "visual_hierarchy": { "type": "number", "minimum": 0, "maximum": 15 },
        "anti_slop_distinctiveness": { "type": "number", "minimum": 0, "maximum": 15 },
        "domain_fit": { "type": "number", "minimum": 0, "maximum": 15 },
        "usability": { "type": "number", "minimum": 0, "maximum": 10 },
        "typography": { "type": "number", "minimum": 0, "maximum": 10 },
        "responsive": { "type": "number", "minimum": 0, "maximum": 10 },
        "state_completeness": { "type": "number", "minimum": 0, "maximum": 10 },
        "brand_coherence": { "type": "number", "minimum": 0, "maximum": 10 },
        "performance_budget": { "type": "number", "minimum": 0, "maximum": 5 }
      }
    },
    "defects_ranked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "type", "message"],
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "type": { "type": "string" },
          "message": { "type": "string" },
          "selector_hint": { "type": "string" },
          "suggested_patch": { "type": "string" }
        }
      }
    },
    "acceptance_status": {
      "type": "string",
      "enum": ["ACCEPTED", "REJECTED_CRITICAL", "NEEDS_REFINEMENT"]
    }
  },
  "additionalProperties": false
}
